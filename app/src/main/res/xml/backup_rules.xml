<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup for Android 11 and older (Android 12+ uses data_extraction_rules.xml).
   Projects (layer images, masks, source photos) are excluded: they easily exceed the 25 MB
   Auto Backup quota, and going over it makes Android skip the WHOLE backup, settings included.
   Settings, the filter library and imported LUTs stay backed up.
-->
<full-backup-content>
    <exclude domain="file" path="projects/" />
</full-backup-content>
