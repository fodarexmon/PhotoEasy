<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+. Cloud backup skips the projects folder: it would exceed the 25 MB quota and make
   Android skip the whole backup. A device-to-device transfer (no quota) keeps everything, which
   is the default when no device-transfer rules are given.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="projects/" />
    </cloud-backup>
</data-extraction-rules>
